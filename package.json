{
  "name": "infraphysics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.js",
    "context": "node scripts/context-pack.js",
    "find": "node scripts/studio-find.js",
    "content:fix": "node scripts/build-content.js --interactive",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "dev": "npm run content && vite",
    "build": "node scripts/media.js sync --soft && npm run content && npm run context && vite build",
    "media": "node scripts/media.js",
    "og": "node scripts/og-cards.js",
    "preview": "vite preview",
    "obsidian:export": "node scripts/obsidian-export.js",
    "obsidian:import": "node scripts/obsidian-import.js"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.15",
    "katex": "^0.16.37",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-force-graph-2d": "^1.29.1",
    "react-force-graph-3d": "^1.29.1",
    "react-router-dom": "^7.18.3",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "marked": "^17.0.1",
    "nanoid": "^5.1.6",
    "sharp": "^0.35.4",
    "shiki": "^3.22.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
